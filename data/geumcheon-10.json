%B2%9C%EA%B5%AC%EC%9D%98%ED%9A%8C+%EC%A0%9C263%ED%9A%8C+%ED%96%89%EC%A0%95%EC%9E%AC%EA%B2%BD%EC%9C%84%EC%9B%90%ED%9A%8C+%EC%A0%9C2%EC%B0%A8","x":"김재선: “구의회와의 협력을 위해서 필요하다면 편성을 할지 검토해 보겠습니다.”"},{"r":"제263회 행정재경위원회 제2차","u":"https://clik.nanet.go.kr/potal/search/searchList.do?collection=minutes&query=%EC%84%9C%EC%9A%B8%ED%8A%B9%EB%B3%84%EC%8B%9C+%EA%B8%88%EC%B2%9C%EA%B5%AC%EC%9D%98%ED%9A%8C+%EC%A0%9C263%ED%9A%8C+%ED%96%89%EC%A0%95%EC%9E%AC%EA%B2%BD%EC%9C%84%EC%9B%90%ED%9A%8C+%EC%A0%9C2%EC%B0%A8","x":"일단 미수납 같은 경우에는 예전에 제가 임시회 때도 질의드렸던 상황이고 전체 100% 비중에 상위 고액체납자들의 문제가 많이 편성되어 있는 부분은 저도 익히 알고는 있습니다. 납세태만에 대해 제가 여쭤봤던 이유 중 하나는 당시에도 제가 얘기했던 것처럼 정말 순수하게 납세태만이 있는 경우도 있지만, 현실적…"},{"r":"제263회 행정재경위원회 제3차","u":"https://clik.nanet.go.kr/potal/search/searchList.do?collection=minutes&query=%EC%84%9C%EC%9A%B8%ED%8A%B9%EB%B3%84%EC%8B%9C+%EA%B8%88%EC%B2%9C%EA%B5%AC%EC%9D%98%ED%9A%8C+%EC%A0%9C263%ED%9A%8C+%ED%96%89%EC%A0%95%EC%9E%AC%EA%B2%BD%EC%9C%84%EC%9B%90%ED%9A%8C+%EC%A0%9C3%EC%B0%A8","x":"지금 국장님이 말씀하신 부분에 대해서 제가 듣고 시급하고 간절함을 느꼈습니다. 그전에 이 부분에 대해서 업무보고를 받을 때 제가 자주 들었던 말 중에 하나는 “기존에 해왔던 것이니까 하려고 합니다.” “그렇게 급하지는 않지만 이왕 하는 것 같이 했으면 좋겠습니다.” 이런 식으로 답변 받았기 때문에 저희 …"},{"r":"제263회 예산결산특별위원회 제2차","u":"https://clik.nanet.go.kr/potal/search/searchList.do?collection=minutes&query=%EC%84%9C%EC%9A%B8%ED%8A%B9%EB%B3%84%EC%8B%9C+%EA%B8%88%EC%B2%9C%EA%B5%AC%EC%9D%98%ED%9A%8C+%EC%A0%9C263%ED%9A%8C+%EC%98%88%EC%82%B0%EA%B2%B0%EC%82%B0%ED%8A%B9%EB%B3%84%EC%9C%84%EC%9B%90%ED%9A%8C+%EC%A0%9C2%EC%B0%A8","x":"직원들 출장횟수가 예측하신 것보다 변동사항이 있다고 말씀하셨는데 그렇게 따지기에는 21% 정도의 차이가 나요. 굉장히 큰 오차범위거든요. 제가 생각했을 때 단순 오차범위는 플러스마이너스 5% 정도가 적당한데, 물론 그렇게 다 맞추시기는 어렵지만 21% 정도 차이나는 것은 솔직히 말씀드리면 출장을 가야함에…"},{"r":"제263회 예산결산특별위원회 제3차","u":"https://clik.nanet.go.kr/potal/search/searchList.do?collection=minutes&query=%EC%84%9C%EC%9A%B8%ED%8A%B9%EB%B3%84%EC%8B%9C+%EA%B8%88%EC%B2%9C%EA%B5%AC%EC%9D%98%ED%9A%8C+%EC%A0%9C263%ED%9A%8C+%EC%98%88%EC%82%B0%EA%B2%B0%EC%82%B0%ED%8A%B9%EB%B3%84%EC%9C%84%EC%9B%90%ED%9A%8C+%EC%A0%9C3%EC%B0%A8","x":"환경공무관 자녀학자금 대여기금 관련 질의 드리겠습니다. 보시면 기금 5억 정도 대비 융자금 회수액이 1,200만 원 정도 수준에 불과하고 있습니다. 지금 국가장학금의 종류가 다양해지지 않았습니까? 대여수요를 확대로 봤을 때, 저희 지자체 학자금 대여수요의 현재 상황이 예전보다 늘었는지 줄었는지가 궁금합니…"},{"r":"제263회 본회의 제2차","u":"https://clik.nanet.go.kr/potal/search/searchList.do?collection=minutes&query=%EC%84%9C%EC%9A%B8%ED%8A%B9%EB%B3%84%EC%8B%9C+%EA%B8%88%EC%B2%9C%EA%B5%AC%EC%9D%98%ED%9A%8C+%EC%A0%9C263%ED%9A%8C+%EB%B3%B8%ED%9A%8C%EC%9D%98+%EC%A0%9C2%EC%B0%A8","x":"이강숙: “아까 ‘부르릉’ 찾아가는 상담 이 부분도 같은 공간으로 구청에서 하고 있으니까 이것을 그쪽으로 거점공간을 찾아가서 상담해 드리는 부분으로 적극 검토하고 추진하겠습니다.”"},{"r":"제263회 본회의 제2차","u":"https://clik.nanet.go.kr/potal/search/searchList.do?collection=minutes&query=%EC%84%9C%EC%9A%B8%ED%8A%B9%EB%B3%84%EC%8B%9C+%EA%B8%88%EC%B2%9C%EA%B5%AC%EC%9D%98%ED%9A%8C+%EC%A0%9C263%ED%9A%8C+%EB%B3%B8%ED%9A%8C%EC%9D%98+%EC%A0%9C2%EC%B0%A8","x":"우리 곁에는 출산과 육아, 가족을 돌보기 위해 잠시 자신의 경력을 내려놓았던 여성들이 있습니다. 이들은 경력을 잃은 사람들이 아니라 그동안 쌓아온 경험과 역량을 여전히 가지고 있는 경력보유여성들입니다. 인구구조의 변화와 생산가능인구 감소에 대응하고, G밸리 기업들의 인력수요까지 함께 고민해야 하는 금천구…"},{"r":"제263회 본회의 제4차","u":"https://clik.nanet.go.kr/potal/search/searchList.do?collection=minutes&query=%EC%84%9C%EC%9A%B8%ED%8A%B9%EB%B3%84%EC%8B%9C+%EA%B8%88%EC%B2%9C%EA%B5%AC%EC%9D%98%ED%9A%8C+%EC%A0%9C263%ED%9A%8C+%EB%B3%B8%ED%9A%8C%EC%9D%98+%EC%A0%9C4%EC%B0%A8","x":"저는 오늘 G밸리와 금천의 지역경제, 그리고 일자리를 어떻게 연결할 것인지에 대해 말씀드리고자 합니다. G밸리는 금천의 가장 큰 경제적 자산입니다. 그럼에도 불구하고 최근 지역 일자리 문제를 살펴보면서 아주 기본적인 의문 하나가 들었습니다. 우리는 과연 G밸리에 있는 기업들을 얼마나 알고 있습니까? 실태…"},{"r":"제262회 본회의 제2차","u":"https://clik.nanet.go.kr/potal/search/searchList.do?collection=minutes&query=%EC%84%9C%EC%9A%B8%ED%8A%B9%EB%B3%84%EC%8B%9C+%EA%B8%88%EC%B2%9C%EA%B5%AC%EC%9D%98%ED%9A%8C+%EC%A0%9C262%ED%9A%8C+%EB%B3%B8%ED%9A%8C%EC%9D%98+%EC%A0%9C2%EC%B0%A8","x":"먼저 제안이유를 말씀드리면, 우리 구에 현재 진행 중인 데이터센터 설치에 따른 주민 불안과 사회적 갈등이 높아진 상황에서 주민의 요구사항과 의견을 수렴하여 사전고지 대상지역의 범위를 확대하고 주민 알권리를 강화하고자 조례를 일부 개정하게 되었습니다. 보다 자세한 내용은 의석에 배부해 드린 자료를 참고하여…"},{"r":"제263회 행정사무감사특별위원회 제0차","u":"https://clik.nanet.go.kr/potal/search/searchList.do?collection=minutes&query=%EC%84%