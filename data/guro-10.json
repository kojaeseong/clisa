A%8C+%EC%9A%B4%EC%98%81%EC%9C%84%EC%9B%90%ED%9A%8C+%EC%A0%9C2%EC%B0%A8","x":"김안순: “오늘 업무보고 후 위원님들의 여러 고견들을 향후 사업 추진과 집행 과정에 적극적으로 반영하겠습니다.”"},{"r":"제347회 운영위원회 제2차","u":"https://clik.nanet.go.kr/potal/search/searchList.do?collection=minutes&query=%EC%84%9C%EC%9A%B8%ED%8A%B9%EB%B3%84%EC%8B%9C+%EA%B5%AC%EB%A1%9C%EA%B5%AC%EC%9D%98%ED%9A%8C+%EC%A0%9C347%ED%9A%8C+%EC%9A%B4%EC%98%81%EC%9C%84%EC%9B%90%ED%9A%8C+%EC%A0%9C2%EC%B0%A8","x":"본 의원 외 6명의 의원께서 발의한 서울특별시 구로구의회 안전관리특별위원회 구성 결의안」은 「지방자치법」 제64조 및 서울특별시 구로구의회 위원회 조례 제10조에 근거하여 우리구에서 발생하는 각종 재난 상황에 대비하고 안전 사고를 사전에 예방하기 위하여 구성·운영하고자 하는 것으로 위원의 수는 7인으로 …"},{"r":"제348회 운영위원회 제1차","u":"https://clik.nanet.go.kr/potal/search/searchList.do?collection=minutes&query=%EC%84%9C%EC%9A%B8%ED%8A%B9%EB%B3%84%EC%8B%9C+%EA%B5%AC%EB%A1%9C%EA%B5%AC%EC%9D%98%ED%9A%8C+%EC%A0%9C348%ED%9A%8C+%EC%9A%B4%EC%98%81%EC%9C%84%EC%9B%90%ED%9A%8C+%EC%A0%9C1%EC%B0%A8","x":"본 의원 외 6명의 의원께서 발의한 구청장 및 관계공무원 출석 요구의 건은 제349회 정례회 기간 중 구정 전반에 대하여 집행부의 행정사무 처리에 관한 내용을 질문하고 그 답변을 구하기 위하여 구청장 및 관계공무원을 출석시키고자 하는 것으로서 출석기간은 9월 18일, 21일, 22일 총 3일간으로 하며,…"},{"r":"제347회 복지건설위원회 제1차","u":"https://clik.nanet.go.kr/potal/search/searchList.do?collection=minutes&query=%EC%84%9C%EC%9A%B8%ED%8A%B9%EB%B3%84%EC%8B%9C+%EA%B5%AC%EB%A1%9C%EA%B5%AC%EC%9D%98%ED%9A%8C+%EC%A0%9C347%ED%9A%8C+%EB%B3%B5%EC%A7%80%EA%B1%B4%EC%84%A4%EC%9C%84%EC%9B%90%ED%9A%8C+%EC%A0%9C1%EC%B0%A8","x":"복지건설위원회에 저도 제가 현장에서 그래도 한 20여 년 복지 쪽만 한 거 같습니다. 많이 참여하고 또 협력해서 구로의 좀 다른 변화를 만드는 데 열심히 해보겠습니다. 반갑습니다. 이근미 입니다."},{"r":"제347회 운영위원회 제1차","u":"https://clik.nanet.go.kr/potal/search/searchList.do?collection=minutes&query=%EC%84%9C%EC%9A%B8%ED%8A%B9%EB%B3%84%EC%8B%9C+%EA%B5%AC%EB%A1%9C%EA%B5%AC%EC%9D%98%ED%9A%8C+%EC%A0%9C347%ED%9A%8C+%EC%9A%B4%EC%98%81%EC%9C%84%EC%9B%90%ED%9A%8C+%EC%A0%9C1%EC%B0%A8"},{"r":"제347회 운영위원회 제2차","u":"https://clik.nanet.go.kr/potal/search/searchList.do?collection=minutes&query=%EC%84%9C%EC%9A%B8%ED%8A%B9%EB%B3%84%EC%8B%9C+%EA%B5%AC%EB%A1%9C%EA%B5%AC%EC%9D%98%ED%9A%8C+%EC%A0%9C347%ED%9A%8C+%EC%9A%B4%EC%98%81%EC%9C%84%EC%9B%90%ED%9A%8C+%EC%A0%9C2%EC%B0%A8","x":"오늘 의사일정을 봤는데요, 운영위원회 안건으로 안전관리특별위원회 구성 결의안만 상정되고 예산결산특별위원회 구성 결의안은 상정되지 않은 것으로 알고 있습니다. 안전관리특별위원회 구성의 필요성은 당연히 공감하고 있고, 그러나 예산결산특별위원회는 의회의 핵심 권한인 예산 심의와 결산 심의, 결산 승인 등을 담…"},{"r":"제348회 운영위원회 제1차","u":"https://clik.nanet.go.kr/potal/search/searchList.do?collection=minutes&query=%EC%84%9C%EC%9A%B8%ED%8A%B9%EB%B3%84%EC%8B%9C+%EA%B5%AC%EB%A1%9C%EA%B5%AC%EC%9D%98%ED%9A%8C+%EC%A0%9C348%ED%9A%8C+%EC%9A%B4%EC%98%81%EC%9C%84%EC%9B%90%ED%9A%8C+%EC%A0%9C1%EC%B0%A8","x":"어떤 취지와 여러 가지 부분에 많은 공감을 하고요. 그리고 정말 필요한 정책이라고 생각하고 있습니다. 그런데 연구 일정을 좀 들여다보니까요. 물론 개괄적으로 설정을 하셨겠지만 이런 청년에 대한 부분은 지금 말씀하신 것처럼 굉장히 다양한 상황에 놓인 청년들도 계시고 그리고 일자리 주거 복지 문화 마음 건강…"},{"r":"제347회 복지건설위원회 제1차","u":"https://clik.nanet.go.kr/potal/search/searchList.do?collection=minutes&query=%EC%84%9C%EC%9A%B8%ED%8A%B9%EB%B3%84%EC%8B%9C+%EA%B5%AC%EB%A1%9C%EA%B5%AC%EC%9D%98%ED%9A%8C+%EC%A0%9C347%ED%9A%8C+%EB%B3%B5%EC%A7%80%EA%B1%B4%EC%84%A4%EC%9C%84%EC%9B%90%ED%9A%8C+%EC%A0%9C1%EC%B0%A8","x":"복지위원회에서 함께해서 기쁘게 생각을 하고요. 김용권 위원장님을 필두로 우리가 정당은 다르지만 구로구민을 위하는 마음은 같기 때문에 같은 뜻을 가지고 앞으로 복지건설위원회에서 제대로 한번 활동해 보겠습니다. 감사합니다."},{"r":"제347회 운영위원회 제2차","u":"https://clik.nanet.go.kr/potal/search/searchList.do?collection=minutes&query=%EC%84%9C%EC%9A%B8%ED%8A%B9%EB%B3%84%EC%8B%9C+%EA%B5%AC%EB%A1%9C%EA%B5%AC%EC%9D%98%ED%9A%8C+%EC%A0%9C347%ED%9A%8C+%EC%9A%B4%EC%98%81%EC%9C%84%EC%9B%90%ED%9A%8C+%EC%A0%9C2%EC%B0%A8","x":"지역 일정을 먼저 좀 검토를 해 보시는 게 좋을 것 같습니다. 그다음에 16쪽에 의원 해외 우수기관 비교시찰, 항상 이 부분이 논란이 되고 있는데요. 본 위원도 8대 가본 경험에 비추어 보면 구로구에 스마트도시 관련해서 연관이 있는 의원들이 정말 가서 선진지를 보고 올 수 있는 어떤 교육지로서 더 면밀히…"},{"r":"제348회 운영위원회 제1차","u":"https://clik.nanet.go.kr/potal/search/searchList.do?collection=minutes&query=%EC%84%9C%EC%9A%B8%ED%8A%B9%EB%B3%84%EC%8B%9C+%EA%B5%AC%EB%A1%9C%EA%B5%AC%EC%9D%98%ED%9A%8C+%EC%A0%9C348%ED%9A%8C+%EC%9A%B4%EC%98%81%EC%9C%84%EC%9B%90%ED%9A%8C+%EC%A0%9C1%EC%B0%A8","x":"지금 연구 내용을 보면 다양한 분야에 너무 폭넓어서 이 기간 안에 정말 어떻게 다 하실지 진행하다가 1, 2차로 거쳐서 가야 되는 건 아닌지 그런 고민이 생기고 지금 제안설명에서도 굉장히 다양하게 폭넓은 제안설명을 해 주셨잖아요. 여기 이 연구 내용 중에 대표하시는 우리 의원님께서 특별히 집중해서 하시고…"},{"r":"제347회 행정기획위원회 제1차","u":"https://clik.nanet.go.kr/potal/search/searchList.do?collection=minutes&query=%EC%84%9C%EC%9A%B8%ED%8A%B9%EB%B3%84%EC%8B%9C+%EA%B5%AC%EB%A1%9C%EA%B5%AC%EC%9D%98%ED%9A%8C+%EC%A0%9C347%ED%9A%8C+%ED%96%89%EC%A0%95%EA%B8%B0%ED%9A%8D%EC%9C%84%EC%9B%90%ED%9A%8C+%EC%A0%9C1%EC%B0%A8"},{"r":"제347회 운영위원회 제2차","u":"https://clik.nanet.go.kr/potal/search/searchList.do?collection=minutes&query=%EC%84%9C%EC%9A%B8%ED%8A%B9%EB%B3%84%EC%8B%9C+%EA%B5%AC%EB%A1%9C%EA%B5%AC%EC%9D%98%ED%9A%8C+%EC%A0%9C347%ED%9A%8C+%EC%9A%B4%EC%98%81%EC%9C%84%EC%9B%90%ED%9A%8C+%EC%A0%9C2%EC%B0%A8","x":"아시다시피 이번 제10대 의회는 45세 미만 청년이 4명이 의회에 들어왔고 또 여성이 다수적으로 이번에는 9대와는 조금 차이가 있는 것으로 알고 있습니다. 해서 언론사도 마찬가지로 여성으로 베이베이 뉴스나 아니면 맘스커리어 이제 또 엄마가 되는 의원도 있기 때문에 여러 가지 특장점이 있기 때문에 이 10…"},{"r":"제348회 운영위원회 제1차","u":"https://clik.nanet.go.kr/potal/search/searchList.do?collection=minutes&query=%EC%84%9C%EC%9A%B8%ED%8A%B9%EB%B3%84%EC%8B%9C+%EA%B5%AC%EB%A1%9C%EA%B5%AC%EC%9D%98%ED%9A%8C+%EC%A0%9C348%ED%9A%8C+%EC%9A%B4%EC%98%81%EC%9C%84%EC%9B%90%ED%9A%8C+%EC%A0%9C1%EC%B0%A8","x":"8월 달에 안 그래도 운영위원회 회의 때 우리 존경하는 김현지 위원님과 제가 출입 기자분들 의장단하고 간담회를 실시를 하시지 않습니까, 그때 저희도 지역 주민분들의 대표성을 가지고 저희도 출입 기자분들하고 간담회를 하고 싶다 열어달라 말씀을 드렸는데 어떻게 결정이 좀 되신 건지 궁금합니다."}],"label":"10대","span":"2026-07~2026-10","members":[{"id":1,"label":"고경희","party":1,"pname":"국민의힘","district":"비례대표","terms":[10],"posts":[],"comm":[],"act":{"sessions":1},"ev":[],"pd":[],"al":[[1,"S",0]],"sl":"guro10-e28c52"},{"id":2,"label":"곽노혁","party":1,"pname":"국민의힘","district":"바선거구 (구로3·4동, 가리봉동)","terms":[9,10],"posts":["부의장"],"comm":[],"act":{"sessions":1},"ev":[],"pd":[],"al":[[1,"S",1]],"sl":"guro10-977118"},{"id":3,"label":"김용권","party":1,"pname":"국민의힘","district":"나선거구 (개봉2·3동)","terms":[9,10],"posts":[],"comm":[],"act":{},"ev":[],"pd":[],"al":[],"sl":"guro10-6dccfb"},{"id":4,"label":"김철규","party":1,"pname":"국민의힘","district":"가선거구 (고척1·2동, 개봉1동)","terms":[10],"posts":[],"c